OPENROUTER_API_KEY=
# Optional comma-separated OpenRouter model IDs (defaults to three provider families).
OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o,google/gemini-2.5-pro
APP_URL=https://your-counterpoint-domain.example
